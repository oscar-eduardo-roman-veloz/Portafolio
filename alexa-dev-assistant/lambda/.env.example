# Copia este archivo como lambda/.env (está en .gitignore) o define las variables en AWS Lambda.

# Opcional: activa "pregunta ..." y las respuestas de respaldo para conceptos/Git desconocidos.
ANTHROPIC_API_KEY=

# Opcional: modelo y nivel de esfuerzo de Claude (por defecto claude-opus-5-5 y low).
# Alexa corta a los 8 segundos; si ves timeouts, prueba SKILL_CLAUDE_MODEL=claude-haiku-5-5.
SKILL_CLAUDE_MODEL=
SKILL_CLAUDE_EFFORT=

# Opcional: repositorio para "cómo va mi repositorio" (owner/nombre) y token para repos privados.
GITHUB_REPO=oscar-eduardo-roman-veloz/Portafolio
GITHUB_TOKEN=
